    {
      "parameters": {
        "jsCode": "const moment = require('moment-timezone');\n\nconst data = $('Place Booking').first().json.body;\nconst configs = $('Configs1').first().json\n\ndata.fullName = (data.firstName || '') + \" \" + (data.lastName || \"\");\n\nconst job_category = $('Find Job Category1').first().json.categoryUID\nconst team_uid = $('Get User Team').first().json.data?.[0]?.team_uid\n\nvar customer_uid = $input.first().json.customer_uid;\nconst input =$('Place Booking').first().json.body\nconst serviceType = input.serviceType\n// customer_uid = customer_uid.customer_uid;\n\nconst jobMasterCF = $('Get Job Master CF').first().json.data\n\nconst customFields = jobMasterCF.map((cf) => ({\n  dependent_on: cf.dependent_on,\n  dependent_options: cf.dependent_options,\n  hide_field: cf.hide_field,\n  hide_to_fe: cf.hide_to_fe,\n  ready_only: cf.read_only,\n  type: cf.field_type,\n  label: cf.field_name,\n  value: cf.field_name == 'Services'?serviceType :'',\n  id: cf.display_order,\n  ...(cf?.group?.group_name && { group_name: cf.group.group_name }),\n  ...(cf?.group?.group_uid && { group_uid: cf.group.group_uid })\n}));\n\nfunction getScheduledDates(slot, selectedDate) {\n  const [startTime, endTime] = slot.split(\" - \");\n\n  const fromDate = moment.tz(\n    `${selectedDate} ${startTime}`,\n    \"YYYY-MM-DD HH:mm A\",\n    configs.TIMEZONE ||  configs.timezone\n  );\n\n  const toDate = moment.tz(\n    `${selectedDate} ${endTime}`,\n    \"YYYY-MM-DD HH:mm A\",\n    configs.TIMEZONE ||  configs.timezone\n  );\n\n  return {\n    start_time: fromDate.utc().format(\"YYYY-MM-DD HH:mm:ss\"),\n    end_time: toDate.utc().format(\"YYYY-MM-DD HH:mm:ss\"),\n  };\n}\n\nvar address = {\n  street: data.street || \"\",\n  city: data.city || \"\",\n  state: data.state || \"\",\n  zip_code: data.zipcode || \"\",\n  country: \"USA\",\n  first_name: data.firstName,\n  last_name: data.lastName,\n  email: data.email || \"\",\n  geo_cordinates: [ data.latitude, data.longitude ]\n}\n\nconst selectedDate = data.selectedDate\nconst slot = data.selectedSlot\nconst scheduledDates = getScheduledDates(slot,selectedDate)\n\nreturn {\n  \"job\": {\n    \"is_recurrence\": false,\n    \"job_priority\": \"HIGH\",\n    \"job_type\": \"NEW\",\n    \"job_category\": job_category,\n    \"job_description\": '',\n    \"job_title\":data.fullName,\n    \"customer_uid\":customer_uid,\n    \"customer_billing_address\": address,\n    \"customer_address\": address,\n    \"scheduled_start_time\": scheduledDates.start_time,\n    \"scheduled_end_time\": scheduledDates.end_time,\n    \"recurrence_dates\": [],\n    \"custom_fields\": customFields || [],\n    \"job_tags\": [\"Website Booking\"],\n    \"assigned_to\": [{\n      user_uid: data.selectedUser,\n      team_uid: team_uid\n    }]\n  }\n};"
      },
