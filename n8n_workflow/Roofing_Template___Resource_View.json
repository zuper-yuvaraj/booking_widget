      "parameters": {
        "jsCode": "let companyUID = $input.first().json.query.company_uid;\nlet serviceType = $input.first().json.body.serviceType;\nlet isValid = true, message = \"\"\n\nconst configs ={\n   \"\": {  //zuper company uuid\n    BASE_URL: \"\", //https://us-east-1.zuperpro.com/api\n    API_KEY: \"\", // api key Zuper Integration\n    timezone: \"\"// Time zone for the application, e.g., \"America/New_York\"\n  }\n}\n\n\nconst jobCategoryMap = {\n \n}\n\nif(!configs[companyUID]) {\n  isValid = false\n  message = \"Company Configs Not Found\"\n}\n\n\nreturn {\n  ...configs[companyUID],\n  jobCategory: \"Roof Inspection\", // jobCategoryMap[serviceType],\n  isValid,\n  message\n}"
