        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\nconst skills = $('Get Skills').first().json.data\nconst input = $('Assisted Scheduling').first().json.query\nlet serviceType = input.serviceType\n\nif(serviceType == \"Gutter Division  \"){\n  serviceType = \"Gutter Division \"\n}\nconst result = skills.find(item => item.skillset_name ===serviceType );\n\nif(!result){\n  return {\n    result :result,\n    serviceType,\n    isValid : false,\n    message  : \"Skill Dosn't matach\"\n  }\n\n}\nreturn {\n  skillset_uid  : result['skillset_uid'],\n  skillset_name  : result['skillset_name'],\n  serviceType,\n  isValid:true\n};"
