        "jsCode": "const { jobCategory } = $('Configs').first().json\nconst categories = $('Get Categories').first().json.data\nlet isValid = true, message = ''\n\nlet selectedCategory = categories.find(category=> category.category_name.toLowerCase() == jobCategory?.toLowerCase())\n\nif(!selectedCategory) {\n  isValid = false\n  message = \"Selected Service Not Found\"\n}\n\nfunction getTotalMinutes(duration) {\n  if(!duration) return 0\n  const { days = 0, hours = 0, minutes = 0 } = duration;\n  return (days * 24 * 60) + (hours * 60) + minutes;\n}\n\nlet duration = getTotalMinutes(selectedCategory?.estimated_duration) || 120\nif(duration > 480) duration = 480\n\nreturn {\n  categoryUID: selectedCategory?.category_uid,\n  categoryName: selectedCategory?.category_name,\n  duration,\n  isValid,\n  message\n}\n"
