    {
      "parameters": {
        "jsCode": "let date = $input.first().json.query.date;\nlet companyUID = $input.first().json.query.company_uid;\nlet serviceType = $input.first().json.query.serviceType;\nconst moment = require(\"moment-timezone\");\n\n\nlet isValid = true, message = \"\"\n\nconst jobCategoryMap = {\n \n}\n\n\nconst configs ={\n   \"\": {  //zuper company uuid\n    BASE_URL: \"\", //https://us-east-1.zuperpro.com/api\n    API_KEY: \"\", // api key Zuper Integration\n    timezone: \"\"// Time zone for the application, e.g., \"America/New_York\"\n  }\n}\n\n\nif(!configs[companyUID]) {\n  isValid = false\n  message = \"Company Configs Not Found\"\n}\n\nconst ALLOWED_FORMATS = [\n  \"YYYY-MM-DD\",\n  \"YYYY-MM-D\",\n  \"YYYY-M-D\",\n  \"YYYY-M-DD\",\n  \"MM/DD/YYYY\",\n  \"MMM DD YYYY\"\n];\n\nfunction getUtcRange(dateStr, tz) {\n  if (!moment.tz.zone(tz)) {\n    return {\n      from: `${dateStr} 00:00:00`,\n      to: `${dateStr} 23:59:59`\n    };\n  }\n\n  // Strict parsing (true = strict mode)\n  const m = moment.tz(dateStr, ALLOWED_FORMATS, true, tz);\n\n  if (!m.isValid()) {\n    return {\n      from: `${dateStr} 00:00:00`,\n      to: `${dateStr} 23:59:59`\n    };\n  }\n\n  const start = m.clone().startOf(\"day\");\n  const end   = m.clone().endOf(\"day\");\n\n  return {\n    from: start.utc().format(\"YYYY-MM-DD HH:mm:ss\"),\n    to: end.utc().format(\"YYYY-MM-DD HH:mm:ss\")\n  };\n}\n\nconst fromTo = getUtcRange(date, configs?.[companyUID]?.timezone ?? null)\n\nreturn {\n  date,\n  ...fromTo,\n  ...configs[companyUID],\n  jobCategory: \"Roof Inspection\", // jobCategoryMap[serviceType],\n  isValid,\n  message\n}"
      },
