    {
      "parameters": {
        "jsCode": "const { jobCategory } = $('Configs1').first().json\nconst categories = $('Get Categories1').first().json.data\nlet isValid = true, message = ''\n\nlet selectedCategory = categories.find(category=> category.category_name.toLowerCase() == jobCategory?.toLowerCase())\nconst scheduledStatus = selectedCategory.job_statuses?.find(stat=>stat.status_type == \"SCHEDULED\")\n\nif(!selectedCategory) {\n  isValid = false\n  message = \"Selected Service Not Found\"\n}\n\nfunction getTotalMinutes(duration) {\n  if(!duration) return 0\n  const { days = 0, hours = 0, minutes = 0 } = duration;\n  return (days * 24 * 60) + (hours * 60) + minutes;\n}\n\n\nreturn {\n  categoryUID: selectedCategory?.category_uid,\n  categoryName: selectedCategory?.category_name,\n  scheduledStatusUID:scheduledStatus?.status_uid,\n  scheduledStatusName: scheduledStatus?.status_name,\n  duration: getTotalMinutes(selectedCategory?.estimated_duration) || 120,\n  isValid,\n  message\n}\n"
