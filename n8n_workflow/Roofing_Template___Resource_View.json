    {
      "parameters": {
        "jsCode": "const data = $(\"Place Booking\").first().json.body;\nconst customerCategories = $('Get Customer Categories').first().json.data\nconst customerMasterCF = $('Get Customer Custom Fields Master').first().json.data\n\nvar address = {\n  street: data.street || \"\",\n  city: data.city || \"\",\n  state: data.state || \"\",\n  zip_code: data.zipcode || \"\",\n  country: \"USA\",\n  first_name: data.firstName,\n  last_name: data.lastName,\n  email: data.email || \"\",\n  geo_cordinates: [data.latitude, data.longitude],\n};\n\nconst customFieldMapping = {\n  \"Lead\": \"Yes\",\n  \"Lead Source\" : \"Website\"\n}\n\nconst customFields = customerMasterCF.map((cf) => ({\n  dependent_on: cf.dependent_on,\n  dependent_options: cf.dependent_options,\n  hide_field: cf.hide_field,\n  hide_to_fe: cf.hide_to_fe,\n  ready_only: cf.read_only,\n  type: cf.field_type,\n  label: cf.field_name,\n  value: customFieldMapping[cf.field_name] || '',\n  id: cf.display_order,\n  ...(cf?.group?.group_name && { group_name: cf.group.group_name }),\n  ...(cf?.group?.group_uid && { group_uid: cf.group.group_uid })\n}));\n\nconst residentialCategory = customerCategories.find(cat => cat.category_name.toLowerCase() === 'residential')?.category_uid\n\nconst payload = {\n  customer: {\n    customer_first_name: data.firstName,\n    customer_last_name: data.lastName,\n    customer_email: data.email,\n    customer_address: address,\n    customer_billing_address: address,\n    customer_all_addresses: [address],\n    customer_contact_no: {\n      mobile: data.phone,\n    },\n    is_portal_enabled: false,\n    portal_permissions: {\n      can_access_organization_records: false,\n      can_create_asset: false,\n      can_create_property: false,\n    },\n    custom_fields: customFields || [],\n    customer_category: residentialCategory || \"\",\n  },\n};\n\nreturn {\n  payload,\n};\n"
      },
