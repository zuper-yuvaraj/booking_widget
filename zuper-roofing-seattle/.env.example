# Copy to .env.local and fill in real values (ask the Zuper team).

# Zuper API keys (territories lookup + user profiles)
TERRITORIES_API_KEY=
NEXT_PUBLIC_ZUPER_API_KEY=

# Google Maps JS API key for the address autocomplete / map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# EmailJS — https://dashboard.emailjs.com (confirmation emails)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
